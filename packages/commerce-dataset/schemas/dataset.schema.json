{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HengPick Commerce Dataset",
  "type": "object",
  "required": [
    "dataset_version",
    "updated_at",
    "categories",
    "products",
    "skus",
    "shops",
    "offers",
    "reviews"
  ],
  "properties": {
    "dataset_version": {
      "type": "string",
      "pattern": "^commerce-demo-[0-9]{4}\\.[0-9]{2}\\.[0-9]+$"
    },
    "updated_at": { "type": "string", "format": "date-time" },
    "categories": { "type": "array", "minItems": 1 },
    "products": { "type": "array", "minItems": 1 },
    "skus": { "type": "array", "minItems": 1 },
    "shops": { "type": "array", "minItems": 1 },
    "offers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "offer_id",
          "sku_id",
          "shop_id",
          "list_price",
          "price",
          "additional_fee",
          "currency",
          "stock_status",
          "valid_from",
          "valid_to",
          "version",
          "dataset_version",
          "updated_at"
        ],
        "properties": {
          "offer_id": { "type": "string" },
          "sku_id": { "type": "string" },
          "shop_id": { "type": "string" },
          "list_price": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
          "price": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
          "additional_fee": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]{2}$"
          },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
          "stock_status": { "type": "string" },
          "valid_from": { "type": "string", "format": "date-time" },
          "valid_to": { "type": "string", "format": "date-time" },
          "version": { "type": "integer", "minimum": 0 },
          "dataset_version": { "type": "string" },
          "updated_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "reviews": { "type": "array" }
  }
}
