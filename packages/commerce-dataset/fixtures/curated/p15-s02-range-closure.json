  "product_content": {
    "P-SONORA-BUDS": {
      "base_price": "1299.00",
      "topic": "noise-cancellation",
      "review": "通勤降噪明显，入耳佩戴稳定。",
      "evidence": "模拟测试显示主动降噪对地铁低频噪声抑制较好，双设备切换稳定。"
    },
    "P-AURALINK-FLOW": {
      "base_price": "899.00",
      "topic": "battery",
      "review": "续航充足，长时间佩戴压力较小。",
      "evidence": "模拟规格记录单次续航十小时，充电盒综合续航四十小时。"
    },
    "P-QUIETARC-H7": {
      "base_price": "1899.00",
      "topic": "comfort",
      "review": "包耳隔音和降噪强，但夏季佩戴偏热。",
      "evidence": "模拟评测确认其降噪深度较高，同时二百四十八克重量需考虑长时佩戴。"
    },
    "P-TRAVELTONE-M2": {
      "base_price": "1499.00",
      "topic": "travel",
      "review": "续航很长，折叠收纳适合出差。",
      "evidence": "模拟差旅测试连续播放可达六十小时，支持双设备连接。"
    },
    "P-CLEARAIR-S20": {
      "base_price": "1099.00",
      "topic": "purification",
      "review": "卧室净化速度够用，睡眠档较安静。",
      "evidence": "模拟规格的颗粒物 CADR 为三百二十立方米每小时，适合中小卧室。"
    },
    "P-BREEZE-MAX": {
      "base_price": "1699.00",
      "topic": "purification",
      "review": "大空间净化快，高档风量声音明显。",
      "evidence": "模拟测试表明大风量适合客厅，但睡眠档噪音高于静音型产品。"
    },
    "P-NIGHTPURE-N1": {
      "base_price": "1299.00",
      "topic": "sleep",
      "review": "夜间运行安静，按键灯可关闭。",
      "evidence": "模拟声学测试睡眠档为十八分贝，适合对夜间噪音敏感的场景。"
    },
    "P-HOMEGUARD-F6": {
      "base_price": "1999.00",
      "topic": "filter",
      "review": "滤芯周期长，甲醛版更适合新房。",
      "evidence": "模拟维护数据表明标准滤芯寿命可达十五个月，实际寿命受污染水平影响。"
    },
    "P-ERGOFIT-E3": {
      "base_price": "1399.00",
      "topic": "ergonomics",
      "review": "腰托和座深调节实用，适合日常办公。",
      "evidence": "模拟人体工学测评确认腰托、座深和头枕均可调，覆盖常见身高区间。"
    },
    "P-MESHWORK-M5": {
      "base_price": "1899.00",
      "topic": "fit",
      "review": "承重和调节范围大，高个用户更容易适配。",
      "evidence": "模拟规格给出一百三十五公斤承重和一百六十五至一百九十五厘米建议身高。"
    },
    "P-SITWELL-L2": {
      "base_price": "899.00",
      "topic": "comfort",
      "review": "坐垫柔软，但腰托和座深不可调。",
      "evidence": "模拟体验记录其基础舒适度尚可，调节能力少，不宜宣称专业人体工学。"
    },
    "P-FLEXSEAT-X7": {
      "base_price": "2399.00",
      "topic": "long-sitting",
      "review": "调节完整、承重高，价格也更高。",
      "evidence": "模拟久坐测评覆盖腰托、四维扶手、座深与头枕调节，适合需要精细适配的用户。"
    }
  }
