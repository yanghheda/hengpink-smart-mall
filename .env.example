# P00-S02 local configuration checklist.
# Copy to a local, untracked .env file. Never commit real secrets.

# Environment: local | test | demo
APP_ENV=local

# Public client configuration (safe for RN/H5 runtime config only)
PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
PUBLIC_H5_BASE_URL=http://localhost:5173
PUBLIC_ALLOWED_H5_ORIGINS=http://127.0.0.1:5173
SMART_MALL_H5_ORIGIN=http://127.0.0.1:5173
PUBLIC_BRIDGE_MAJOR=1
PUBLIC_API_CONTRACT_VERSION=v1

# Commerce service configuration
COMMERCE_PORT=8080
COMMERCE_INTERNAL_AGENT_URL=http://localhost:8000
COMMERCE_INTERNAL_SERVICE_TOKEN=replace-me
COMMERCE_DATASET_VERSION=commerce-demo-2026.09.2

# MySQL / Redis / Qdrant 均通过常驻 SSH 隧道访问 VMware VM。
INFRA_TUNNEL_HOST=127.0.0.1
MYSQL_HOST=${INFRA_TUNNEL_HOST}
MYSQL_PORT=13306
MYSQL_DATABASE=hengpick
MYSQL_USERNAME=hengpick
MYSQL_PASSWORD=replace-me
MYSQL_URL=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}
# REDIS_PASSWORD is a secret; URL-encode it if it contains URL-reserved characters.
REDIS_PASSWORD=replace-me
REDIS_URL=redis://:${REDIS_PASSWORD}@${INFRA_TUNNEL_HOST}:16379/0
QDRANT_URL=http://${INFRA_TUNNEL_HOST}:16333

# Agent service configuration
AGENT_PORT=8000
AGENT_TOOL_API_BASE_URL=http://127.0.0.1:8080
AGENT_MODEL_PROVIDER=stub
AGENT_MODEL_NAME=local-stub
AGENT_MODEL_BASE_URL=http://localhost:11434/v1
AGENT_MODEL_API_KEY=replace-me
AGENT_EMBEDDING_MODEL=local-stub-embedding
AGENT_MAX_MODEL_CALLS=3
AGENT_ENABLE_CACHE_FALLBACK=true

# Observability; do not put tokens or raw prompts in logs.
OTEL_SERVICE_NAME=hengpick-local
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=INFO
